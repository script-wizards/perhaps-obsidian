{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "rootDir": "src",
    "paths": {
      "@scriptwizards/perhaps-engine": [
        "./node_modules/@scriptwizards/perhaps-engine/src/index.ts"
      ]
    }
  },
  "include": ["src"]
}
